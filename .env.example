# Beauty Pulse — credential template.
# Copy to .env (gitignored) and fill in. Never commit the filled copy.
#
# These are needed only by the collection notebooks (NB01x), which are not in
# the public repo because the raw data they write is not published. The public
# pipeline — NB03 to NB07 and the dashboard — reads the database and the CSV
# assets, and needs none of these.

# Rakuten Web Service (Ichiba Item Search / Ranking).
# Register an application at https://webservice.rakuten.co.jp/ to get both.
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=

# YouTube Data API v3, for the video and comment pulls.
# Google Cloud console -> enable "YouTube Data API v3" -> create an API key.
YOUTUBE_API_KEY=

# Apify, used for the @cosme and Amazon JP scrapes. Optional: the code treats
# it as absent rather than raising, so leave it blank if you are not running
# those sources.
APIFY_API_TOKEN=

# e-Stat (政府統計の総合窓口), for the official-statistics validation layer:
# METI 生産動態統計 shipments and 総務省 家計調査 household spend.
# Free: register at https://www.e-stat.go.jp/ -> マイページ -> 新規登録 ->
# アプリケーションID発行. Unlike the four above, this one IS needed by the
# public pipeline, since the validation runs from the published statistics
# rather than from scraped data.
ESTAT_APP_ID=
