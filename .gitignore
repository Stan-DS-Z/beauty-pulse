# Beauty Pulse — .gitignore

# ── Credentials — NEVER commit ────────────────────────────────────────────
.env
*.key
*.pem

# ── Data ──────────────────────────────────────────────────────────────────
data/raw/
data/interim/
dashboard/assets/signal_pulse.db

# Private DB — contains product_name and raw_json
data/*.db
# Public DB — shipped gzipped: the raw file crossed GitHub's 100 MB limit
# once the corpus grew. The dashboard reads CSVs, never the DB, so this only
# affects readers querying it directly (gunzip first).
dashboard/assets/signal_pulse_public.db
!dashboard/assets/signal_pulse_public.db.gz

# SQLite WAL artefacts
data/*.db-shm
data/*.db-wal

# ── Notebooks — scraping / reconnaissance (not part of public pipeline) ───
notebooks/NB01*.ipynb
notebooks/recon/

# Company-specific analysis — private
notebooks/NB05a_*.ipynb
notebooks/NB05b_*.ipynb
notebooks/NB05c_*.ipynb

# ── Outputs — generated; not in repo ──────────────────────────────────────
outputs/
!outputs/.gitkeep

# Company-specific chart outputs — private
outputs/nb05a_*.png
outputs/nb05b_*.png
outputs/nb05c_*.png
outputs/wordcloud_skincare_*.png
outputs/wordcloud_cosmetics_*.png

# ── Fonts ─────────────────────────────────────────────────────────────────
dashboard/assets/fonts/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.nbconvert.ipynb

# ── OS / IDE ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Local analysis scripts (not for git) ──────────────────────────────────
seo_keywords.py
seo_keywords_output.json
stamps_extraction.py
stamps_by_category.json

# ── Claude Code memory (assistant notes, not project code) ────────────────
memory/